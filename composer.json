{
  "name": "mahankals/plugin-manager",
  "version": "dev-main",
  "description": "package-description",
  "keywords": [
    "cakephp",
    "plugin"
  ],
  "type": "composer-plugin",
  "license": "MIT",
  "authors": [
    {
      "name": "Atul Mahankal",
      "email": "atulmahankal@gmail.com"
    }
  ],
  "require": {
    "composer-plugin-api": "^2.0",
    "cakephp/cakephp": "5.2.*"
  },
  "autoload": {
    "psr-4": {
      "PluginManager\\": "src/"
    }
  },
  "extra": {
    "cakephp-plugin": true,
    "class": "PluginManager\\ComposerPlugin"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
