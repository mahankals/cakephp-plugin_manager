{
    "name": "mahankals/plugin-manager",
    "description": "CakePHP 5 plugin for managing and discovering other plugins",
    "keywords": [
        "cakephp",
        "plugin",
        "plugin-manager"
    ],
    "type": "cakephp-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Atul Mahankal",
            "email": "atulmahankal@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "cakephp/cakephp": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "PluginManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PluginManager\\Test\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
